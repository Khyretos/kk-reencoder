# Copy to .env and fill in what you need; an empty value means the default in the comment.
# Every RX_* setting is explained in README.md > Settings.

# Host
RX_MEDIA_DIR=         # host folder with the library, mounted as /media; default ./media (kireserver: /media)
RX_UID=               # owner of the media files (`id -u`); default 1000
RX_GID=               # its group (`id -g`); default 1000
RX_RENDER_DEVICE=     # GPU render node for qsv/vaapi; default /dev/dri/renderD128 (override example)
RX_RENDER_GID=        # host render group id (`getent group render`); default 993 (override example)
RX_PROXY_NETWORK=     # reverse-proxy network (override example); default nginx-reverse-proxy_default
RX_BIND=              # host address of the published port; default 127.0.0.1
RX_HOST_PORT=         # host port; default 8080
RX_IMAGE=             # image name; default kk-reencoder:local
RX_MEM_LIMIT=         # memory cap; default 3g
RX_CPUS=              # CPU cap; default 4
TZ=                   # time zone for the page and logs; default UTC (kireserver: Europe/Amsterdam)

# What to work on
RX_ROOTS=             # library folders inside the container, comma list; default every folder in /media
                      # (kireserver: /media/Anime,/media/Cartoons,/media/Movies,/media/Series)
RX_MODE=              # report (measure only), manual (only ticked series) or stage (everything); default report
RX_CODECS=            # default h264,hevc,mpeg4,vc1,mpeg2video,wmv3,msmpeg4v3
RX_SKIP_HDR=          # default true
RX_MAX_HEIGHT=        # default 2160

# Hardware
RX_ENCODER=           # qsv, vaapi, nvenc or svt (CPU); default qsv
RX_HW_DECODE=         # default true
RX_PARALLEL=          # 1-5; default 2
RX_VMAF_THREADS=      # default 4
RX_FFMPEG_THREADS=    # default 2

# Quality
RX_TARGET_VMAF=       # default 95
RX_MAX_RATIO=         # default 0.95
RX_FILTERS=           # e.g. Anime=deband; default none
RX_SAMPLES=           # default 3
RX_SAMPLE_LEN=        # default 20
RX_SEARCH_PER_FOLDER= # default 2
RX_CHECK_EVERY_EPISODE= # default true

# Space and housekeeping
RX_MAX_STAGED_GB=     # default 1000
RX_RESCAN_S=          # default 86400
