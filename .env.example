# Copy to .env and fill in what you need; an empty value means the default in the comment.
# Every RX_* setting is explained in README.md > Settings.

# Host
# host folder with the library, mounted as /media; default ./media (kireserver: /media)
RX_MEDIA_DIR=
# owner of the media files (`id -u`); default 1000
RX_UID=
# its group (`id -g`); default 1000
RX_GID=
# GPU render node for qsv/vaapi; default /dev/dri/renderD128 (override example)
RX_RENDER_DEVICE=
# host render group id (`getent group render`); default 993 (override example)
RX_RENDER_GID=
# reverse-proxy network (override example); default nginx-reverse-proxy_default
RX_PROXY_NETWORK=
# host address of the published port; default 127.0.0.1
RX_BIND=
# host port; default 8080
RX_HOST_PORT=
# image name; default kk-reencoder:local
RX_IMAGE=
# memory cap; default 3g
RX_MEM_LIMIT=
# CPU cap; default 4
RX_CPUS=
# time zone for the page and logs; default UTC (kireserver: Europe/Amsterdam)
TZ=

# What to work on
# library folders inside the container, comma list; default every folder in /media
# (kireserver: /media/Anime,/media/Cartoons,/media/Movies,/media/Series)
RX_ROOTS=
# report (measure only), manual (only ticked series) or stage (everything); default report
RX_MODE=
# default h264,hevc,mpeg4,vc1,mpeg2video,wmv3,msmpeg4v3
RX_CODECS=
# default true
RX_SKIP_HDR=
# default 2160
RX_MAX_HEIGHT=

# Hardware
# qsv, vaapi, nvenc or svt (CPU); default qsv
RX_ENCODER=
# default true
RX_HW_DECODE=
# 1-5; default 2
RX_PARALLEL=
# default 4
RX_VMAF_THREADS=
# default 2
RX_FFMPEG_THREADS=

# Quality
# default 95
RX_TARGET_VMAF=
# default 0.95
RX_MAX_RATIO=
# e.g. Anime=deband; default none
RX_FILTERS=
# default 3
RX_SAMPLES=
# default 20
RX_SAMPLE_LEN=
# default 2
RX_SEARCH_PER_FOLDER=
# default true
RX_CHECK_EVERY_EPISODE=

# Space and housekeeping
# default 1000
RX_MAX_STAGED_GB=
# default 86400
RX_RESCAN_S=
